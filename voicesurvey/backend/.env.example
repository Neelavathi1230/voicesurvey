# Copy to .env and edit. Never commit .env.
DATABASE_URL=sqlite:///./voicesurvey.db
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
MAX_MESSAGE_CHARS=2000
MAX_AUDIO_BYTES=4000000
# "browser" = respondents' browsers transcribe (Web Speech API). "whisper" = server transcribes (needs faster-whisper).
STT_ENGINE=browser
WHISPER_MODEL=base
